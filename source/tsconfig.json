{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "preserveConstEnums": true,
    "outDir": "../dist",
    "verbatimModuleSyntax": false, // otherwise const enums are not inlined, unfortunately

    "jsx": "react-jsx",
    "jsxImportSource": "#scribbler",

    "skipLibCheck": false
  },
  "include": ["**/*"],
  "exclude": ["**/__tests__/**/*"]
}
